# Built binaries — `make build` emits ./warden in the repo root
/warden
/proxy
cmd/proxy/proxy

# Coverage / test output
coverage.out
*.out

# Generated proxy certs/keys (gen-certs.sh, test/e2e/certs/gen.sh) — NEVER
# commit private keys. Keep the e2e gen.sh tracked, ignore its outputs.
/certs/
test/e2e/certs/*
!test/e2e/certs/gen.sh
*.crt
*.key
*.pem
*.srl

# Local SQLite analytics databases
*.db
*.db-shm
*.db-wal
*.sqlite

# Local secrets / env
.env

# Claude Code local-only settings (keep .claude/skills symlink + shared config tracked)
.claude/settings.local.json

# OS / editor cruft
.DS_Store

# Internal design material — not shipped
plan/
