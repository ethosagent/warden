# DEV PLACEHOLDERS ONLY. Never use these values outside a laptop or CI.
# Per-worker tokens and the control plane's admin token for every compose recipe
# that runs a control plane: docker-compose.control-plane.yml, the e2e stack, and
# docker-compose.yml / .hermes / .openclaw / .zeroclaw / .ethos, which each run one
# worker on WARDEN_WORKER_1_TOKEN (docs/control-plane.md).
# The compose files already default to these values, so `make e2e` needs no
# setup. To override, copy this file to deploy/compose/.env (git-ignored) or
# load it with: set -a; . deploy/compose/.env.example; set +a
#
# A worker token is "wwt_" + 52 lowercase base32 characters (a-z, 2-7), one per
# worker, bound to that worker's proxy id by cp-bootstrap. Real values are
# generated per deployment and never committed:
#   echo wwt_$(head -c32 /dev/urandom | base32 | tr -d = | tr A-Z a-z | head -c52)
WARDEN_WORKER_1_TOKEN=wwt_devonlyworkeronetokennotarealsecretxxxxxxxxxxxxxxxxx
WARDEN_WORKER_2_TOKEN=wwt_devonlyworkertwotokennotarealsecretxxxxxxxxxxxxxxxxx
WARDEN_WORKER_3_TOKEN=wwt_devonlyworkerthreetokennotarealsecretxxxxxxxxxxxxxxx
# The control plane's own bearer for dashboard writes (--admin-token-env). Not a
# worker credential: a worker token never opens the dashboard write routes.
WARDEN_CP_ADMIN_TOKEN=dev-cp-admin-token
