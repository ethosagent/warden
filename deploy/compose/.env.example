# DEV PLACEHOLDERS ONLY. Never use these values outside a laptop or CI.
# Per-worker credentials and the control plane's admin token for every compose
# recipe that runs a control plane. docker-compose.control-plane.yml (and the
# signed-bundles overlay on it) enrolls its workers with one-time wet_ tokens
# (WARDEN_WORKER_N_ENROLL) and runs strict-certs. The e2e stack and
# docker-compose.yml / .hermes / .openclaw / .zeroclaw / .ethos still use per-worker
# wwt_ tokens (WARDEN_WORKER_N_TOKEN; docs/control-plane.md, "Migrating from
# per-worker tokens" shows how to move them).
# The compose files already default to these values, so `make e2e` needs no
# setup. To override, copy this file to deploy/compose/.env (git-ignored) or
# load it with: set -a; . deploy/compose/.env.example; set +a
#
# An enrollment token is "wet_" + 52 lowercase base32 characters (a-z, 2-7), one per
# worker, bound to that worker's id by cp-bootstrap and good for ONE enrollment
# (within workerCA.enrollTokenTTL, 1h by default). Real values are generated per
# deployment and never committed:
#   echo wet_$(head -c32 /dev/urandom | base32 | tr -d = | tr A-Z a-z | head -c52)
WARDEN_WORKER_1_ENROLL=wet_devonlyworkeroneenrolltokennotarealsecretxxxxxxxxxxx
WARDEN_WORKER_2_ENROLL=wet_devonlyworkertwoenrolltokennotarealsecretxxxxxxxxxxx
#
# A worker token is "wwt_" + 52 lowercase base32 characters (a-z, 2-7), one per
# worker, bound to that worker's proxy id by cp-bootstrap. Real values are
# generated per deployment and never committed:
#   echo wwt_$(head -c32 /dev/urandom | base32 | tr -d = | tr A-Z a-z | head -c52)
WARDEN_WORKER_1_TOKEN=wwt_devonlyworkeronetokennotarealsecretxxxxxxxxxxxxxxxxx
WARDEN_WORKER_2_TOKEN=wwt_devonlyworkertwotokennotarealsecretxxxxxxxxxxxxxxxxx
WARDEN_WORKER_3_TOKEN=wwt_devonlyworkerthreetokennotarealsecretxxxxxxxxxxxxxxx
# The control plane's own bearer for dashboard writes (--admin-token-env). Not a
# worker credential: a worker token never opens the dashboard write routes.
WARDEN_CP_ADMIN_TOKEN=dev-cp-admin-token
