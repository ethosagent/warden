# DEV PLACEHOLDERS ONLY. Never use these values outside a laptop or CI.
# Load with: set -a; . deploy/compose/dex/.env.example; set +a
WARDEN_CONSOLE_DEX_CLIENT_SECRET=dev-console-secret-change-me
WARDEN_DEX_CLIENT_SECRET=dev-dataplane-secret-change-me
HARNESS_DEX_CLIENT_SECRET=dev-harness-secret-change-me
# Dex binds to LDAP as the admin DN, so both hold the same value.
LDAP_ADMIN_PASSWORD=dev-ldap-admin-change-me
LDAP_BIND_PW=dev-ldap-admin-change-me
# Plaintext of every {SSHA} hash in seed.ldif (alice, bob, carol, dave).
DEX_TEST_PASSWORD=dev-test-password
